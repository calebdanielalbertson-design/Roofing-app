generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  ESTIMATOR
}

enum EstimateStatus {
  DRAFT
  FINAL
}

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  jobs             Job[]
  materialSkus     MaterialSku[]
  laborRoles       LaborRole[]
  equipmentRates   EquipmentRate[]
  markupProfiles   MarkupProfile[]
  lineItemCatalogs LineItemCatalog[]
  costBooks        CostBook[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      Role     @default(ESTIMATOR)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  customerName String
  address     String
  city        String?
  state       String?
  zip         String?
  carrierName String?
  claimNumber String?
  
  // Job-specific notes or contacts could go here

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  measurements MeasurementSet[]
  estimates    Estimate[]
}

model MeasurementSet {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  name      String   @default("Initial Measurements")
  
  // Core Dimensions
  totalRoofAreaSqFt    Decimal @default(0)
  totalPitchedAreaSqFt Decimal @default(0)
  
  // Linear Measurements
  ridgeLf   Decimal @default(0)
  hipLf     Decimal @default(0)
  valleyLf  Decimal @default(0)
  eaveLf    Decimal @default(0)
  rakeLf    Decimal @default(0)
  
  // Other Inputs
  stories   Int     @default(1)
  pitch     String? // e.g. "6/12"
  wastePct  Decimal @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estimates Estimate[]
}

// --- CATALOG & COSTING ---

model MaterialSku {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  skuCode     String   // e.g. "RFG300"
  description String
  unit        String   // e.g. "Bundle"
  
  purchasePackagePrice Decimal @default(0) // Cost to buy one package
  unitsPerPackage      Decimal @default(1) // Conversion
  defaultMargin        Decimal @default(0.30) // 30% default

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, skuCode])
}

model LaborRole {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String   // e.g. "RFG", "DMO"
  description String
  hourlyRate  Decimal  @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, code])
}

model EquipmentRate {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String   // e.g. "DMOFEE"
  description String
  rate        Decimal  @default(0)
  unit        String   // e.g. "Ton", "Day"

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, code])
}

model LineItemCatalog {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String   // e.g. "300S"
  name        String
  description String?  // Narrative template
  unit        String   // SQ, LF, EA
  category    String?
  isActive    Boolean  @default(true)
  
  // The Recipe
  // Stored as JSON for MVP flexibility, but validates against SKUs in app logic.
  // {
  //   materials: [{ skuCode: "RFG300", quantity: 1, divisor: 1 }],
  //   labor: [{ roleCode: "RFG", productionRate: 0.956 }],
  //   equipment: [{ code: "DMOFEE", quantity: 1 }]
  // }
  recipe      Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  estimateLines  EstimateLine[]
  costComponents CostComponent[] // Legacy/Cache support
}

// CostBook allows versioning prices over time (Snapshotting SKUs/Rates)
// For MVP, we might just use the live tables, but let's keep this object.
model CostBook {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String   @default("Standard Pricing")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  estimates      Estimate[]
}

// Optional: If we want to cache the calculated unit cost per line item per cost book
model CostComponent {
  id              String   @id @default(uuid())
  lineItemId      String
  lineItem        LineItemCatalog @relation(fields: [lineItemId], references: [id])
  
  // Cached unit costs
  materialUnitCost Decimal @default(0)
  laborUnitCost    Decimal @default(0)
  equipmentUnitCost Decimal @default(0)
  
  updatedAt       DateTime @updatedAt
}

model MarkupProfile {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String   @default("Default")
  
  materialMarkup  Decimal @default(0)
  laborMarkup     Decimal @default(0)
  equipmentMarkup Decimal @default(0)
  overhead        Decimal @default(0)
  profit          Decimal @default(0)
  
  estimates Estimate[]
}

// --- ESTIMATION ---

model Estimate {
  id              String   @id @default(uuid())
  jobId           String
  job             Job      @relation(fields: [jobId], references: [id])
  measurementSetId String?
  measurementSet  MeasurementSet? @relation(fields: [measurementSetId], references: [id])
  costBookId      String?
  costBook        CostBook? @relation(fields: [costBookId], references: [id])
  markupProfileId String?
  markupProfile   MarkupProfile? @relation(fields: [markupProfileId], references: [id])
  
  status          EstimateStatus @default(DRAFT)
  name            String?
  
  // Frozen totals
  totalMaterial   Decimal @default(0)
  totalLabor      Decimal @default(0)
  totalEquipment  Decimal @default(0)
  subtotal        Decimal @default(0)
  totalOverhead   Decimal @default(0)
  totalProfit     Decimal @default(0)
  grandTotal      Decimal @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines           EstimateLine[]
  documents       Document[]
}

model EstimateLine {
  id          String   @id @default(uuid())
  estimateId  String
  estimate    Estimate @relation(fields: [estimateId], references: [id])
  lineItemId  String
  lineItem    LineItemCatalog @relation(fields: [lineItemId], references: [id])
  
  quantity    Decimal
  
  // Computed values (Snapshot)
  unitPrice   Decimal
  material    Decimal // Extended Material
  labor       Decimal // Extended Labor
  equipment   Decimal // Extended Equipment
  extended    Decimal // Total Extended

  // Detailed breakdown for transparency (JSON)
  // { materialUnit: 100, laborUnit: 50, ... }
  breakdown   Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Document {
  id          String   @id @default(uuid())
  estimateId  String
  estimate    Estimate @relation(fields: [estimateId], references: [id])
  name        String
  url         String
  type        String
  createdAt   DateTime @default(now())
}
